BOT_TOKEN=123456:ABC-DEF_your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
# Optional, default: gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated Telegram user IDs. Empty = allow everyone (not recommended).
ALLOWED_USER_IDS=111111111,222222222
# SQLite path and timezone for day/week boundaries
DATABASE_PATH=data/kbju.db
TIMEZONE=Europe/Moscow
